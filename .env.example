STEAD_MYSQL_DATABASE=stead
STEAD_MYSQL_USER=stead
STEAD_MYSQL_PASSWORD=replace-with-a-generated-password
STEAD_MYSQL_ROOT_PASSWORD=replace-with-a-different-generated-password
STEAD_API_TOKENS='[{"principal":"alice","token":"replace-with-a-generated-64-character-hex-token"}]'
STEAD_BIND_ADDRESS=127.0.0.1
STEAD_PORT=8080

# Optional OpenAI-compatible model endpoint and exact model name.
STEAD_MODEL_ENDPOINT=
STEAD_MODEL=
STEAD_MODEL_API_KEY=
# Optional fallback for DashScope authentication.
DASHSCOPE_API_KEY=

# Optional Feishu scheduling delivery. Use comma-separated bare chat IDs.
STEAD_FEISHU_APP_ID=
STEAD_FEISHU_APP_SECRET=
STEAD_FEISHU_CHATS=
